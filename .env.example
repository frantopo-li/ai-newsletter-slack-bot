# Bot token (starts with xoxb-)
# api.slack.com/apps > your app > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# Signing secret
# api.slack.com/apps > your app > Basic Information > App Credentials
SLACK_SIGNING_SECRET=xxx

# Port where the server runs. Keep 3000 for local development.
PORT=3000

# URL of the webhook trigger of your Workflow Builder.
# It's generated when you change the trigger of the workflow to "From a webhook"
WORKFLOW_WEBHOOK_URL=https://hooks.slack.com/workflows/...  

# ID of the channel where the bot will post
TARGET_CHANNEL_ID=C0C01F7QFH7

# ID of the channel where the bot posts error alerts.
# Optional: falls back to TARGET_CHANNEL_ID when empty.
ADMIN_CHANNEL_ID=C0BVB2QREF3
